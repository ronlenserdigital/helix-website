# Copy to .env.local for local dev. Set the same keys in Vercel > Project > Settings > Environment Variables.

# GoHighLevel (sub-account). Private integration token or agency API key with contacts.write scope.
GHL_API_KEY=
GHL_LOCATION_ID=
# Optional: custom field ids so need/budget/message land in named fields, not only tags.
GHL_FIELD_NEED_ID=
GHL_FIELD_BUDGET_ID=
GHL_FIELD_MESSAGE_ID=

# Optional email copy of every lead via Resend.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=hello@helixresearchtech.com
LEAD_FROM_EMAIL=Helix Website <leads@helixresearchtech.com>

# Public: GHL calendar embed shown on /contact. Use your white-label domain if you have one.
# Example: https://api.leadconnectorhq.com/widget/booking/XXXXXXXX
NEXT_PUBLIC_GHL_CALENDAR_URL=

# Public: Google Tag Manager container id (GTM-XXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GTM_ID=
